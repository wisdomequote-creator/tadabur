{"number":111,"name":"سُورَةُ المَسَدِ","englishName":"Al-Masad","englishNameTranslation":"The Palm Fibre","revelation":"meccan","ayahCount":5,"ayat":[{"n":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ تَبَّتْ يَدَآ أَبِى لَهَبٍۢ وَتَبَّ"},{"n":2,"text":"مَآ أَغْنَىٰ عَنْهُ مَالُهُۥ وَمَا كَسَبَ"},{"n":3,"text":"سَيَصْلَىٰ نَارًۭا ذَاتَ لَهَبٍۢ"},{"n":4,"text":"وَٱمْرَأَتُهُۥ حَمَّالَةَ ٱلْحَطَبِ"},{"n":5,"text":"فِى جِيدِهَا حَبْلٌۭ مِّن مَّسَدٍۭ"}]}