{"number":112,"name":"سُورَةُ الإِخۡلَاصِ","englishName":"Al-Ikhlaas","englishNameTranslation":"Sincerity","revelation":"meccan","ayahCount":4,"ayat":[{"n":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ هُوَ ٱللَّهُ أَحَدٌ"},{"n":2,"text":"ٱللَّهُ ٱلصَّمَدُ"},{"n":3,"text":"لَمْ يَلِدْ وَلَمْ يُولَدْ"},{"n":4,"text":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ"}]}