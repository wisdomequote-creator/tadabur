{"number":113,"name":"سُورَةُ الفَلَقِ","englishName":"Al-Falaq","englishNameTranslation":"The Dawn","revelation":"meccan","ayahCount":5,"ayat":[{"n":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ"},{"n":2,"text":"مِن شَرِّ مَا خَلَقَ"},{"n":3,"text":"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ"},{"n":4,"text":"وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِى ٱلْعُقَدِ"},{"n":5,"text":"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ"}]}