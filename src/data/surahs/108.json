{"number":108,"name":"سُورَةُ الكَوۡثَرِ","englishName":"Al-Kawthar","englishNameTranslation":"Abundance","revelation":"meccan","ayahCount":3,"ayat":[{"n":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِنَّآ أَعْطَيْنَٰكَ ٱلْكَوْثَرَ"},{"n":2,"text":"فَصَلِّ لِرَبِّكَ وَٱنْحَرْ"},{"n":3,"text":"إِنَّ شَانِئَكَ هُوَ ٱلْأَبْتَرُ"}]}