{"number":109,"name":"سُورَةُ الكَافِرُونَ","englishName":"Al-Kaafiroon","englishNameTranslation":"The Disbelievers","revelation":"meccan","ayahCount":6,"ayat":[{"n":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ يَٰٓأَيُّهَا ٱلْكَٰفِرُونَ"},{"n":2,"text":"لَآ أَعْبُدُ مَا تَعْبُدُونَ"},{"n":3,"text":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ"},{"n":4,"text":"وَلَآ أَنَا۠ عَابِدٌۭ مَّا عَبَدتُّمْ"},{"n":5,"text":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ"},{"n":6,"text":"لَكُمْ دِينُكُمْ وَلِىَ دِينِ"}]}